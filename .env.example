# Polymarket 5 分钟涨跌预挂机器人 —— 环境变量示例（Railway 的 Variables 里逐项填；本地运行可复制成 .env）
# 不填的项用默认值。默认 LIVE=off：只跑模拟盘，不会下任何真实订单。

# ---------- 运行模式 ----------
LIVE=off                       # on = 实盘（需要下面的私钥）；off = 模拟盘（内存里的假订单簿，不需要私钥）

# ---------- 账户（LIVE=on 才需要） ----------
POLY_PRIVATE_KEY=              # 签名私钥：账户的签名地址私钥，或已授权的 Session Key 私钥（0x 开头）
POLY_WALLET=                   # 账户钱包地址：polymarket.com 右上角个人菜单里的地址（Deposit/Proxy/Safe 钱包）
POLY_RELAYER_API_KEY=          # 网页钱包要自动领取奖金就必填：polymarket.com → Settings → API Keys → Relayer API Keys 创建
POLY_RELAYER_API_KEY_ADDRESS=  # 可选：上面那个 Key 显示的 Signer Address
POLY_API_KEY=                  # 一般不填：三项都空着，程序用 POLY_PRIVATE_KEY 自动生成。填了就必须是这把私钥生成的，
                               # 否则每张单都会被拒（the order signer address has to be the address of the API KEY）
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# ---------- 挂哪些市场 ----------
PREOPEN_MARKETS=all            # all = btc,eth,sol,xrp,doge,hype,bnb 七个币的 5 分钟涨跌；也可写 btc,eth；none = 都不挂
PREOPEN_WEEKEND=on             # off = 北京时间周六 00:00 到周一 08:00 开始的场次不挂

# ---------- 价格与份数 ----------
PREOPEN_PRICE_CENTS=49         # 每边买价（美分，0.1～50）；涨、跌两边各挂一张 post-only 买单
PREOPEN_SHARES=10              # 每边份数（≥5，Polymarket 最小 5 份；≥50 份才可能拿流动性奖励）
PREOPEN_LEVELS=                # 更深的档位：价格x份数，逗号分隔，如 48x20,47x40（价格逐档递减，最多再 7 档）
PREOPEN_DEEP_AHEAD_MINUTES=0   # 第 2 档起只挂这么多分钟内开始的场次；0 = 和第一档一样

# ---------- 时间 ----------
PREOPEN_AHEAD_MINUTES=1440     # 只挂这么多分钟内开始的场次（10～1500；1440 = 发布即挂，约开场前 24 小时）
PREOPEN_CANCEL_SECONDS=60      # 开场前多少秒撤单（之后每 2 秒催一次，直到撤掉）
PREOPEN_EXPIRY_SECONDS=30      # 订单（GTD）在开场前多少秒自动失效：撤单失败时的兜底
PREOPEN_ENTRY_SECONDS=300      # 距开场不足多少秒不再新挂（GTD 规则要求 ≥ 到期秒数 + 150）

# ---------- 资金 ----------
PREOPEN_MAX_OPEN_USD=0         # 本程序全部挂单合计的上限（美元）；0 = 不限。Polymarket 按市场分别核对余额、各场不共用：
                               # 余额够一场（默认 $9.80）就能挂全部场次；设了这个数，挂单合计最多这么多，开场最近的先挂
PREOPEN_MAX_EXPOSURE_USD=0     # 风控：未结算场次里单边成交最坏会亏的钱到这个数就撤掉没成交的挂单、停止新挂，结算后恢复；0 = 不限
PREOPEN_MAX_DAILY_LOSS_USD=0   # 风控：今天（北京时间）已结算亏损到这个数就撤单停挂，零点后恢复；0 = 不限
PAPER_BALANCE_USD=1000         # 模拟盘的假余额

# ---------- 其他 ----------
PREOPEN_DB=/data/preopen.sqlite3   # 账本（务必放在持久卷上；模拟盘自动用 preopen.paper.sqlite3）
PREOPEN_AUTO_REDEEM=on         # 实盘：结算后自动领取赢的一边（智能钱包需要 Relayer Key；EOA 需要 POL 付 gas）
PREOPEN_CANCEL_ON_EXIT=off     # on = 进程退出时撤掉全部挂单；off = 留在簿上（到期自动失效，重启后接管）
PREOPEN_MAX_ATTEMPTS=3         # 一场一档因自身原因失败后最多重报几次
PREOPEN_KEY_EXCLUSIVE=off      # off = 只撤本程序自己签的单（同一个 API Key 下别的策略不受影响）；on = 确认 Key 只给本程序用，可按市场扫单、一次撤光
TELEGRAM_BOT_TOKEN=            # 可选：Telegram 通知、按钮和命令（找 @BotFather 建机器人）
TELEGRAM_CHAT_ID=              # 可选：你自己的用户 ID（私聊）或群组 ID（负数）；通知发到这里，命令只在这里接受
TELEGRAM_ADMIN_IDS=            # 可选：能操作的管理员用户 ID，逗号分隔；不填 = TELEGRAM_CHAT_ID 本人（私聊）。群组必须填，否则命令和按钮都不生效
WEB_KEY=                       # 可选：网页控制台的密码（至少 12 位）；Railway 生成域名后浏览器打开，用它登录
# WEB_URL=                     # 一般不用填：Railway 生成域名后会自动提供 RAILWAY_PUBLIC_DOMAIN
LOG_LEVEL=INFO

# ---------- 高级（一般不用改） ----------
# PREOPEN_POLL_SECONDS=5       # 平时扫描间隔
# PREOPEN_FAST_POLL_SECONDS=0.5  # 预计发布时刻前后的快速扫描间隔
# PREOPEN_SNAPSHOT_SECONDS=10  # 读账户挂单的间隔
# PREOPEN_ORDER_RATE=30        # 本地下单限速（每秒订单数；Standard 档位 40/秒、突发 60）
# PREOPEN_ORDER_BURST=50
# PREOPEN_CANCEL_RATE=60       # 本地撤单限速（Standard 档位 80/秒、突发 120）
# PREOPEN_CANCEL_BURST=100
# PREOPEN_WORKERS=8            # 并行下单协程数
